{
	"schemaVersion": 1,
	"id": "sakura",
	"version": "${version}",
	"name": "Sakura Client",
	"description": "Glassmorphism-styled client GUI, HUD and utilities for Minecraft 1.21.11.",
	"authors": [
		"Idontkonw"
	],
	"license": "GPL-3.0-or-later",
	"environment": "client",
	"mixins": [
		"sakura.mixins.json"
	],
	"entrypoints": {
		"client": [
			"com.sakura.client.SakuraClient",
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}